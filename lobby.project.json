{
  "name": "RobloxGameTemplate-Lobby",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$ignoreUnknownInstances": true,
      "$path": "src/ReplicatedFirst"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "Lobby": {
          "$path": "src/Places/Lobby/StarterPlayer/StarterCharacterScripts"
        }
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Audio": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Audio"
        },
        "Interface": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Interface"
        },
        "Lobby": {
          "$path": "src/Places/Lobby/StarterPlayer/StarterPlayerScripts"
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Modules": {
        "$path": "src/ReplicatedStorage/Modules"
      },
      "Lobby": {
        "$path": "src/Places/Lobby/ReplicatedStorage"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "CharacterSetup": {
        "$path": "src/ServerScriptService/CharacterSetup.server.lua"
      },
      "PlayerData": {
        "$path": "src/ServerScriptService/PlayerData.server.lua"
      },
      "Lobby": {
        "$path": "src/Places/Lobby/ServerScriptService"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "Packages": {
        "$path": "src/ServerStorage/Packages"
      },
      "Lobby": {
        "$path": "src/Places/Lobby/ServerStorage"
      }
    }
  }
}
